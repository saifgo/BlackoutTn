# Copy this file to .env.local and fill in the values.
# All variables must be prefixed with VITE_ so Vite exposes them to the client bundle.

# --- Appwrite (database + auth) ---
# Cloud endpoint (leave as-is for Appwrite Cloud; change if self-hosting).
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_REPORTS_COLLECTION_ID=

# --- Firebase (Analytics only) ---
# Analytics stays on Firebase; database + auth have been moved to Appwrite.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional
VITE_FIREBASE_MEASUREMENT_ID=
